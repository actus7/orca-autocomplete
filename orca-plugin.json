{
  "manifestVersion": 2,
  "id": "autocomplete",
  "name": "Autocomplete",
  "version": "0.1.0",
  "execution": "trusted-worker",
  "description": "Gray inline suggestions as you type, powered by the AI provider you choose: OpenAI, Anthropic, OpenRouter, Ollama or any compatible API.",
  "license": "MIT",
  "repository": "https://github.com/actus7/orca-autocomplete",
  "engines": {
    "orca": ">=1.4.248"
  },
  "main": "src/main.ts",
  "contributes": {
    "panels": [
      {
        "id": "setup",
        "title": "Autocomplete",
        "icon": "zap",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "enabled",
        "title": "Enabled",
        "description": "Turn inline suggestions on or off. The Autocomplete panel and the status bar item do the same.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "format",
        "title": "Provider format",
        "description": "Set by the provider you pick in the Autocomplete panel.",
        "type": "string",
        "enum": [
          "openai",
          "anthropic"
        ],
        "enumLabels": [
          "OpenAI-compatible (/chat/completions)",
          "Anthropic-compatible (/v1/messages)"
        ],
        "default": "openai"
      },
      {
        "key": "baseUrl",
        "title": "Base URL",
        "description": "Set by the provider you pick in the Autocomplete panel, where the API key is kept too.",
        "type": "string",
        "default": "https://api.openai.com/v1",
        "placeholder": "http://localhost:11434/v1"
      },
      {
        "key": "model",
        "title": "Model",
        "description": "A fast model works best: answers slower than 1.8 seconds are dropped. Change it in the Autocomplete panel.",
        "type": "string",
        "default": "gpt-4o-mini"
      },
      {
        "key": "maxTokens",
        "title": "Max tokens",
        "description": "Longest suggestion to request. The default suits most code.",
        "type": "integer",
        "default": 96,
        "minimum": 16,
        "maximum": 512
      },
      {
        "key": "languageServers",
        "title": "Use language servers",
        "description": "Start the language servers already installed on this computer (such as rust-analyzer, gopls, pyright or typescript-language-server) for errors, hover, go to definition and more in the Autocomplete editor. Needs the file to be inside an Orca workspace.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "editorFollowOrca",
        "title": "Match Orca's editor",
        "description": "Use the same font, size, wrapping and minimap as Orca's own editor, and follow every change you make to them in Orca. Turn it off to use the four settings below instead.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "editorFontFamily",
        "title": "Editor font",
        "description": "Used when Match Orca's editor is off or Orca's settings cannot be read. Empty uses the default.",
        "type": "string",
        "default": ""
      },
      {
        "key": "editorFontSize",
        "title": "Editor font size",
        "description": "Used when Match Orca's editor is off or Orca's settings cannot be read. 0 uses the default (13).",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 24
      },
      {
        "key": "editorWordWrap",
        "title": "Wrap long lines",
        "description": "Used when Match Orca's editor is off or Orca's settings cannot be read.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "editorMinimap",
        "title": "Show the minimap",
        "description": "Used when Match Orca's editor is off or Orca's settings cannot be read.",
        "type": "boolean",
        "default": false
      }
    ],
    "commands": [
      {
        "id": "toggle",
        "title": "Autocomplete: Turn on or off"
      },
      {
        "id": "test",
        "title": "Autocomplete: Test connection"
      }
    ],
    "statusBarItems": [
      {
        "id": "status",
        "icon": "zap",
        "text": "setup",
        "tone": "neutral",
        "tooltip": "Autocomplete",
        "command": "toggle"
      }
    ],
    "customEditors": [
      {
        "id": "code-typescript",
        "title": "Autocomplete",
        "extensions": [
          ".ts",
          ".tsx",
          ".mts",
          ".cts"
        ],
        "entry": "editor/pages/typescript.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-javascript",
        "title": "Autocomplete",
        "extensions": [
          ".js",
          ".jsx",
          ".mjs",
          ".cjs"
        ],
        "entry": "editor/pages/javascript.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-python",
        "title": "Autocomplete",
        "extensions": [
          ".py",
          ".pyi",
          ".pyw"
        ],
        "entry": "editor/pages/python.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-go",
        "title": "Autocomplete",
        "extensions": [
          ".go"
        ],
        "entry": "editor/pages/go.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-rust",
        "title": "Autocomplete",
        "extensions": [
          ".rs"
        ],
        "entry": "editor/pages/rust.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-java",
        "title": "Autocomplete",
        "extensions": [
          ".java"
        ],
        "entry": "editor/pages/java.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-kotlin",
        "title": "Autocomplete",
        "extensions": [
          ".kt",
          ".kts"
        ],
        "entry": "editor/pages/kotlin.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-csharp",
        "title": "Autocomplete",
        "extensions": [
          ".cs",
          ".csx"
        ],
        "entry": "editor/pages/csharp.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-cpp",
        "title": "Autocomplete",
        "extensions": [
          ".c",
          ".h",
          ".cpp",
          ".cc",
          ".cxx",
          ".hpp",
          ".hh",
          ".hxx"
        ],
        "entry": "editor/pages/cpp.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-php",
        "title": "Autocomplete",
        "extensions": [
          ".php"
        ],
        "entry": "editor/pages/php.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-ruby",
        "title": "Autocomplete",
        "extensions": [
          ".rb",
          ".rake",
          ".gemspec"
        ],
        "filenames": [
          "Gemfile",
          "Rakefile"
        ],
        "entry": "editor/pages/ruby.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-swift",
        "title": "Autocomplete",
        "extensions": [
          ".swift"
        ],
        "entry": "editor/pages/swift.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-shell",
        "title": "Autocomplete",
        "extensions": [
          ".sh",
          ".bash",
          ".zsh"
        ],
        "entry": "editor/pages/shell.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-sql",
        "title": "Autocomplete",
        "extensions": [
          ".sql"
        ],
        "entry": "editor/pages/sql.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-html",
        "title": "Autocomplete",
        "extensions": [
          ".html",
          ".htm"
        ],
        "entry": "editor/pages/html.html",
        "priority": "default",
        "frame": "isolated"
      },
      {
        "id": "code-generic",
        "title": "Autocomplete",
        "extensions": [
          ".css",
          ".scss",
          ".less",
          ".xml",
          ".yaml",
          ".yml",
          ".md",
          ".dart",
          ".lua",
          ".r",
          ".ps1",
          ".bat",
          ".scala",
          ".ex",
          ".exs",
          ".clj",
          ".pl",
          ".fs",
          ".jl",
          ".tf",
          ".proto",
          ".graphql",
          ".dockerfile"
        ],
        "filenames": [
          "Dockerfile"
        ],
        "entry": "editor/pages/generic.html",
        "priority": "default",
        "frame": "isolated"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "secrets:own"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    }
  ],
  "icon": "assets/icon.png",
  "homepage": "https://github.com/actus7/orca-autocomplete",
  "cover": {
    "path": "assets/cover.png",
    "alt": "The plugin name, Autocomplete, beside a code editor where gray suggested code follows the cursor and a Tab key hint shows how to accept it"
  },
  "screenshots": [
    {
      "path": "assets/screenshot-editor.png",
      "alt": "A TypeScript function where a gray suggestion follows the cursor, with a Tab key hint beside it",
      "caption": "A gray suggestion at the cursor. Tab accepts it."
    }
  ]
}
